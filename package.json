{
  "name": "2brain-logic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-feeding second brain: notes land in an Obsidian vault stored in Git.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests evals vitest.config.ts vitest.evals.config.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "evals": "vitest run --config vitest.evals.config.ts",
    "start": "tsc -p tsconfig.build.json && node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "gray-matter": "4.0.3",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
