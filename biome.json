{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    { "includes": ["plugin/skills/**/*.md"], "formatter": { "enabled": false } },
    { "includes": ["tests/fixtures/**/*.expected.md"], "formatter": { "enabled": false } }
  ],
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  }
}
