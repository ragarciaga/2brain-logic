# Copy to .env and fill in. Never commit .env.
# Or run `docker compose run --rm setup` to write .env for you.

# Where the vault clone lives. In Docker compose this is overridden to /data/vault.
VAULT_DIR=./vault
# The vault repository to clone when VAULT_DIR is empty. Use an SSH URL (deploy key) or a URL
# that carries a credential only in your private .env.
VAULT_REMOTE=git@example.com:you/vault.git
# Identity on the commits the service makes.
GIT_AUTHOR_NAME=2brain
GIT_AUTHOR_EMAIL=2brain@example.com

# Secret, required: the service refuses to start without it. At least 32 characters. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# and set it only in your private .env. Never commit it.
INGEST_TOKEN=

# HTTP listener. HOST stays on loopback for a local run; compose sets 0.0.0.0 inside the container.
PORT=3000
HOST=127.0.0.1

# Public MCP endpoint (optional). Leave PUBLIC_BASE_URL empty and MCP stays disabled; the other
# variables in this block are then not read. When it is set, the service refuses to start unless
# OWNER_PASSPHRASE_HASH is well formed.
# PUBLIC_BASE_URL is the origin only, no path: https, or http for localhost or 127.0.0.1.
PUBLIC_BASE_URL=
MCP_PORT=3001
# Hash of the owner passphrase, from `node dist/cli.js hash-passphrase` (the passphrase goes in on
# standard input, 12 characters or more).
# Wrap the value in single quotes: it contains `$`. Never commit it.
OWNER_PASSPHRASE_HASH=
# Bare host names (lowercase, punycode for IDN), comma separated, that an OAuth client may
# redirect to. Leave empty for claude.ai,claude.com,chatgpt.com.
ALLOWED_REDIRECT_HOSTS=
# Where the OAuth state lives. Must not be inside VAULT_DIR.
AUTH_STORE_DIR=/data/auth
# Exactly the number of reverse proxies in front of the service (0 when clients connect directly).
# setup writes 0 when PUBLIC_BASE_URL is empty and 1 when it is set (one reverse proxy).
TRUST_PROXY_HOPS=0

# Secret. Left empty on purpose: the skeleton makes no real model calls and does not read it.
ANTHROPIC_API_KEY=

# Compose only: name of the existing Docker network that n8n runs on.
N8N_NETWORK=n8n
