# Copy to .env and fill in. Never commit .env.

# Where the vault clone lives. In Docker compose this is overridden to /data/vault.
VAULT_DIR=./vault
# The vault repository to clone when VAULT_DIR is empty. Use an SSH URL (deploy key) or a URL
# that carries a credential only in your private .env.
VAULT_REMOTE=git@example.com:you/vault.git
# Identity on the commits the service makes.
GIT_AUTHOR_NAME=2brain
GIT_AUTHOR_EMAIL=2brain@example.com

# Secret, required: the service refuses to start without it. At least 32 characters. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# and set it only in your private .env. Never commit it.
INGEST_TOKEN=

# HTTP listener. HOST stays on loopback for a local run; compose sets 0.0.0.0 inside the container.
PORT=3000
HOST=127.0.0.1

# Secret. Left empty on purpose: the skeleton makes no real model calls and does not read it.
ANTHROPIC_API_KEY=

# Compose only: name of the existing Docker network that n8n runs on.
N8N_NETWORK=n8n
